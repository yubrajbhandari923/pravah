{
  "name": "pravah-architecture-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-only scientific architecture explorer for the PRAVAH repository",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:evidence": "node scripts/check-evidence.mjs",
    "lock:evidence": "node scripts/check-evidence.mjs --write-lock"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
