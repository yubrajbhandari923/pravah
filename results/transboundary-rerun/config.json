{
  "name": "transboundary",
  "experiment": "transboundary",
  "notes": "SYNTHETIC demonstration of EXTERNAL vs LOCAL pollution. Every number below is a demonstration value, NOT an estimate for any place. local = emitted inside the study region; external = outside it (explicit source or outer-inflow-boundary input). The study region is only a reporting mask / weight, never a PDE wall; it is not a national border, so the words 'international transboundary' are not used. All source and sensor coordinates are STUDY-RELATIVE metres (origin = south-west corner of the study region); the simulation domain adds a buffer on every side, so domains A and B hold the same physical problem. Profiles are piecewise-constant steps: [[t_start, value], ...].",
  "geometry": {
    "study_size": 10000.0,
    "domains": {
      "A": {
        "buffer": 5000.0,
        "dx": 250.0
      },
      "B": {
        "buffer": 10000.0,
        "dx": 250.0
      }
    }
  },
  "physics": {
    "K": 100.0,
    "H": 500.0,
    "lam": 4.6296296296296294e-05,
    "T": 21600.0,
    "output_interval": 600.0,
    "dt": 60.0,
    "t_exclude": 3600.0
  },
  "wind": {
    "speed": 1.0,
    "toward_deg": 22.5,
    "comment": "toward_deg = direction the air moves TOWARD, counter-clockwise from +x (east); 22.5 deg = wind from the west-south-west"
  },
  "sources": {
    "L1": {
      "group": "local",
      "x": 3000.0,
      "y": 3500.0,
      "q": 100000.0,
      "sigma": 500.0
    },
