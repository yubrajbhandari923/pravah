                 "interior+upwind": [[2000, 2500], [5000, 1500], [8000, 3000], [2000, 7000], [5000, 5500], [8000, 8000], [-2000, 1500], [-2000, 6500]],
                 "interior8": [[2000, 2500], [5000, 1500], [8000, 3000], [2000, 7000], [5000, 5500], [8000, 8000], [3500, 4500], [6500, 6500]]}},
  "special": {"noise_reps": 2, "prior_alphas": [0.0, 1.0, 1e4], "prior_scenarios": ["mixed"]},
