+def _dirty_info(rev: str | None) -> dict[str, Any]:
+    """Additive: short sha256 of ``git diff HEAD`` and the list of changed/untracked files (None outside a git repo),
+    so a run from a dirty tree can be identified."""
+    if not rev:
